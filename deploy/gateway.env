# Dev Jira gateway. Read by render.py (plain KEY=VALUE, no quotes or inline comments).
# P/R: GCP project and region. N: name of the Cloud Run service, Artifact Registry repo and
# service account. AUD: the audience callers request. The five *_SECRET values are Secret
# Manager names: the config (settings and grants, written by `deploy.sh secrets`) and the four
# OAuth client values (created by the user; deploy.sh never reads them).
P=example-dev-project
R=us-central1
N=fullsend-jira-gateway-dev
AUD=fullsend-jira-gateway-dev
ISSUER=https://token.actions.githubusercontent.com
CONFIG_SECRET=fullsend-jira-gateway-dev-grants
READ_ID_SECRET=fullsend-jira-gateway-dev-read-client-id
READ_SECRET_SECRET=fullsend-jira-gateway-dev-read-client-secret
WRITE_ID_SECRET=fullsend-jira-gateway-dev-write-client-id
WRITE_SECRET_SECRET=fullsend-jira-gateway-dev-write-client-secret
# Memory: the gateway runs with GOMEMLIMIT at 80% of MEMORY, and render.py requires
# 12 x CONCURRENCY x MAX_RESPONSE_BYTES + 32 MiB <= GOMEMLIMIT: a budget of 12 copies of a
# maximum-size response for every request in flight (the read buffer plus the filter, which
# measures about 3 copies; see README "Memory"). FILTER_SLOTS bounds concurrent filtering.
# 12 x 10 x 3 MiB + 32 MiB = 392 MiB <= 409 MiB (80% of 512 MiB).
MIN_INSTANCES=0
MAX_INSTANCES=1
CONCURRENCY=10
CPU=1
MEMORY=512Mi
MAX_RESPONSE_BYTES=3145728
FILTER_SLOTS=2
